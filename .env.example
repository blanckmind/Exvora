# ==============================================================================
# Exvora - Environment Configuration Template
# ==============================================================================
# In accordance with the Critical Zero-Assumption Rule, no credentials or endpoints
# are pre-filled with guessed values.
#
# Set AUTH_MODE to 'mock' for local development & feature testing.
# Set AUTH_MODE to 'srm' for live institutional OIDC SSO integration once official
# credentials have been provided by SRMIST IT administrators.
# ==============================================================================

# Authentication Mode ('mock' | 'srm')
AUTH_MODE=mock

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Secret (Random 32+ character string for signing Exvora session cookies)
# Generate via: openssl rand -base64 32
SESSION_SECRET=exvora_dev_super_secret_session_key_replace_in_prod_32chars

# ==============================================================================
# Official SRMIST Single Sign-On (OIDC / OAuth 2.0) Configuration
# Leave blank until official institutional details are provided by SRM IST.
# DO NOT GUESS OR FABRICATE THESE VALUES.
# ==============================================================================
SRM_ISSUER=
SRM_CLIENT_ID=
SRM_CLIENT_SECRET=
SRM_AUTHORIZATION_URL=
SRM_TOKEN_URL=
SRM_USERINFO_URL=
SRM_JWKS_URL=
SRM_REDIRECT_URI=http://localhost:3000/api/auth/callback
SRM_SCOPES=openid profile email
SRM_END_SESSION_URL=
